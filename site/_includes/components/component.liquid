<!DOCTYPE html>
<html dir="ltr" lang="en">
{%- for template_info in component_templates %}
  {% if template_info.id == id %}
      {% assign template_tag = template_info.template %}
      {% assign preview_tag = template_info.template %}
  {% endif %}
{% endfor -%}
{%- for component in components %}
  {% if component.id == id %}
      {%- for version_info in component.versions %}
        {% assign version_tag = version_info.name %}
      {% endfor -%}
      {% if component.customtemplates %}
        {%- for custom in component.customtemplates %}
          {% assign template_tag = custom.name %}
          {% assign use_custom_url = custom.path %}
        {% endfor -%}
      {% endif %}
  {% endif %}
{% endfor -%}
<head>
    {% render '_partials/scripts_styles' %}
    <title>{{ title }}</title>
    <script>
    document.addEventListener("DOMContentLoaded", function(event) {
        const versionText = document.getElementById('current-version');
        const templateText = document.getElementById('current-template');
        const versionSelect = document.getElementById('version-select');
        const templateSelect = document.getElementById('template-select');
        const previewSelect = document.getElementById('preview');
        versionSelect.addEventListener('change', function() {
            updateIFrame();
        });
        templateSelect.addEventListener('change', function() {
            updateIFrame();
        });
        previewSelect.addEventListener('change', function() {
            updateIFrame();
        });
    });

    function updateIFrame() {
        const versionSelect = document.getElementById('version-select');
        const templateSelect = document.getElementById('template-select');
        const previewSelect = document.getElementById('preview');
        const iframe = document.getElementById('iframe');
        if (iframe) {
            const previewValue = previewSelect.value;
            if (previewValue == 'preview') {
              iframe.src = `/component/{{ id }}/{{ preview_tag | slugify }}_preview/index.html`;
              document.querySelectorAll('.hide-on-preview').forEach(el => el.style.display = 'none');
            } else if (previewValue == 'previewdev') {
              iframe.src = `/component/{{ id }}/{{ preview_tag | slugify }}_preview_dev/index.html`;
              document.querySelectorAll('.hide-on-preview').forEach(el => el.style.display = 'none');
            } else {
              iframe.src = `${templateSelect.value}?${versionSelect.value}`;
              document.querySelectorAll('.hide-on-preview').forEach(el => el.style.display = '');
            }
            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });
        }
    }
    </script>
</head>
<body style="margin: 0;">
<ilw-page class="ilw-font">
    {% render '_partials/header' %}
    <main style="container-type: inline-size;">
      <ilw-page-title width="page">
        <img src="https://cdn.brand.illinois.edu/patterns/finial/blue.svg" alt="" slot="background">
        <h1>{{ title }}</h1>
      </ilw-page-title>
      <ilw-columns width="page" padding="20px 0" gap="20px" mode="3x1" style="margin-bottom: 20px; border-bottom: 2px solid var(--il-blue);">
      <ilw-content mode="introduction">
        <p><em>{{ component.description }}</em></p>
      </ilw-content>
       {% if preview_tag %}
       <ilw-content>
          <label for="preview">Builder or Preview:</label>
          <select id="preview" style="width: calc(100% - 50px);">
            <option value="builder" selected>Builder</option>
            <option value="preview">Preview (latest production only)</option>
            <option value="previewdev">Preview (latest development only)</option>
          </select>
       </ilw-content>
       {% endif %}
      </ilw-columns>
      <ilw-spacer></ilw-spacer>
      {% if use_custom_url %}
      <iframe id="iframe" src="{{ use_custom_url }}?version={{ version_tag }}" style="width: calc(100vw - 20px); margin: 0; padding: 0; border: none;" title="{{ title }} Builder IFrame" ></iframe>
      {% else %}
      <iframe id="iframe" src="/component/{{ id }}/{{ template_tag | slugify }}/index.html?version={{ version_tag }}" style="width: calc(100vw - 20px); margin: 0; padding: 0; border: none;" title="{{ title }} Builder IFrame" ></iframe>
      {% endif %}
      <ilw-spacer></ilw-spacer>

      <ilw-content width="page">
      <h2 class="hide-on-preview">Choose Alternate Versions</h2>
      <ilw-columns class="hide-on-preview" >
       <div>
          <label for="version-select">Choose a version:</label>
          <select class="hide-on-preview" id="version-select" style="width: calc(100% - 50px);">
          <option value="{{ version_tag }}" selected>Default version ({{ version_tag }})</option>
          {%- for component in components %}
              {% if component.id == id %}
                  {%- for version_info in component.versions %}
                    <option value="{{ version_info.name }}">{{ version_info.name }} {{ version_info.notes }} (for best results, choose template {{  version_info.template }})</option>
                  {% endfor -%}
              {% endif %}
          {% endfor -%}
          <option value="dev">Latest development version</option>
        </select>
       </div>
       <div>
         <label class="hide-on-preview" for="template-select">Choose a template:</label>
         <select class="hide-on-preview" id="template-select" style="width: calc(100% - 50px);">
         {% if use_custom_url %}
           <option value="{{ custom.path }}" selected>Default template ({{ template_tag }})</option>
         {% else %}
           <option value="/component/{{ id }}/{{ template_tag | slugify }}" selected>Default template ({{ template_tag }})</option>
         {% endif %}
         {%- for template_info in component_templates %}
         {% if template_info.id == id %}
           <option value="/component/{{ id }}/{{ template_info.template | slugify }}">{{ template_info.template }} {{ template_info.notes }}</option>
         {% endif %}
         {% endfor -%}
         {%- for component in components %}
         {% if component.id == id %}
         {% if component.customtemplates %}
             {%- for custom in component.customtemplates %}
             <option value="{{ custom.path }}">{{ custom.name }} {{ custom.notes }}</option>
             {% endfor -%}
         {% endif %}
         {% endif %}
         {% endfor -%}
         </select>
        </div>
      </ilw-columns>
      </ilw-content>
      <ilw-spacer></ilw-spacer>
      <ul class="ilw-buttons">
        <li><a href="{{ sourceRepository }}/issues/new">Contact us about a problem</a></li>
        <li><a href="{{ sourceRepository }}">View repository on GitHub</a></li>
      </ul>
      <ilw-content width="page">
        <h2>Component Notes for Latest Version</h2>
        {{ content }}
      </ilw-content>
      <ilw-spacer></ilw-spacer>
      <ilw-back-to-top></ilw-back-to-top>
    </main>
    {% render '_partials/footer' %}
</ilw-page>
</body>
</html>
