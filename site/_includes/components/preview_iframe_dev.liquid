<!DOCTYPE html>
<html dir="ltr" lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.brand.illinois.edu/illinois.css">
    <link rel="stylesheet" href="https://dev.toolkit.illinois.edu/ilw-global/latest/ilw-global.css">
    <link rel="stylesheet" href="/stylesheets/components/preview.css">
    {% if component_template.usejs %}
    <script type="module" src="https://dev.toolkit.illinois.edu/{{ component_template.tag }}/latest/{{ component_template.tag }}.js"></script>
    {% endif %}
    {% if component_template.usejs %}
    <link rel="stylesheet" href="https://dev.toolkit.illinois.edu/{{ component_template.tag }}/latest/{{ component_template.tag }}.css">
    {% endif %}
    {% if component_template.added-components %}
        {%- for added in component_template.added-components %}
            {% if added.css %}
            <link rel="stylesheet" href="{{ added.css }}">
            {% endif %}
            {% if added.js %}
            <script type="module" src="{{ added.js }}"></script>
            {% endif %}
        {% endfor -%}
    {% endif %}
    <title>{{ component_template.title }} Builder IFrame Preview</title>
</head>
<body style="margin: 0;">
    <main>

    {% capture html_attributes %} {%- for attribute in component_template.attributes-fixed %} {{attribute.name}}="{{attribute.value}}" {% endfor -%} {% endcapture %}
    {% capture html_classes %} {%- for classname in component_template.classes-fixed %} {{classname.value}} {% endfor -%} {% endcapture %}
    {% capture html_text %} <{{ component_template.builder-information.element-name }} {{ html_attributes }} class="{{html_classes}}"> {% endcapture %}
    {% capture html_text_end %} </{{ component_template.builder-information.element-name }}> {% endcapture %}

    {%- for sample in component_template.samples %}
        <div class="builder-section"><h2>Preview: Base level for {{ sample.name }}</h2></div>
        <div role="presentation" class="builder-line top"></div>
        <div style="{{ component_template.builder-information.parent-style }}">
        {{ html_text }}
        {{ sample.text }}
        {{ html_text_end }}
        </div>
        <div role="presentation" class="builder-line bottom"></div>

        {%- for attribute in component_template.attributes %}
            {%- for attribute_value in attribute.values %}
                {% capture html_optional_attribute %} {{attribute.name}}='{{attribute_value}}' {% endcapture %}
                {% capture html_text_attribute %} <{{ component_template.builder-information.element-name }} {{ html_attributes }} {{ html_optional_attribute }} class="{{html_classes}}"> {% endcapture %}
               <div class="builder-section"><h2>Preview: {{ sample.name }} and {{ attribute.name }} = {{ attribute_value }} </h2></div>
               <div role="presentation" class="builder-line top"></div>
               <div style="{{ component_template.builder-information.parent-style }}">
                {{ html_text_attribute }}
                {{ sample.text }}
                {{ html_text_end }}
                </div>
                <div role="presentation" class="builder-line bottom"></div>
            {% endfor -%}
        {% endfor -%}
        
        {%- for classname in component_template.classes %}
            {%- for class_value in classname.values %}
                {% capture html_optional_classes %} {{html_classes}} {{class_value}} {% endcapture %}
                {% capture html_text_class %} <{{ component_template.builder-information.element-name }} {{ html_attributes }} class="{{html_optional_classes}}"> {% endcapture %}
                <div class="builder-section"><h2>Preview: {{ sample.name }} and {{ html_classes }} = {{ class_value }} </h2></div>
                <div role="presentation" class="builder-line top"></div>
                <div style="{{ component_template.builder-information.parent-style }}">
                {{ html_text_class }}
                {{ sample.text }}
                {{ html_text_end }}
                </div>
                <div role="presentation" class="builder-line bottom"></div>
            {% endfor -%}
        {% endfor -%}

    {% endfor -%}
    </main>
</body>
</html>