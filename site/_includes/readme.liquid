<!DOCTYPE html>
<html dir="ltr" lang="en">
<head>
    {% render 'scripts_styles_toolkit' %}
    <title>{{ title }}</title>
    <style>
      code {
          background: #e7e7f7;
          font-size: 1.2rem;
          overflow-wrap: break-word;
      }
      pre code {
          display: block;
          padding: 1rem;
          overflow-x: auto;
      }
      ilw-page-title img {
         -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .5), rgba(0, 0, 0, 0));
      }
    </style>
</head>
<body style="margin: 0;">
<ilw-page class="ilw-margin ilw-font">
    {% render 'header' %}
    <main>
      <ilw-page-title width="page">
        <img src="https://cdn.brand.illinois.edu/patterns/finial/blue.svg" alt="" slot="background">
        <h1>{{ repository }} README</h1>
      </ilw-page-title>
      <ilw-content>
        <p><a href="{{ sourceRepository }}">View {{ repository }} on GitHub</a></p>
        {{ content }}
      </ilw-content>
      <ilw-spacer></ilw-spacer>
    </main>
    {% render 'footer' %}
</ilw-page>
</body>
</html>
