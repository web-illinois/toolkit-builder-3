<!DOCTYPE html>
<html dir="ltr" lang="en">
  <head>
    {% render '_partials/scripts_styles_environment' with environment as environment %}
    <title>{{ title }}</title>
    <style>
      ilw-page-title img {
        -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0));
        width: 100%;
      }
    </style>
  </head>
  <body style="margin: 0;">
    <ilw-page class="ilw-font">
      {% render '_partials/header' %}
      <main>
          <ilw-content width="page">
            <h1>{{ title }} - {{ environment.title }}</h1>
            {{ content }}
          </ilw-content>
      </main>
      {% render '_partials/footer' %}
    </ilw-page>
  </body>
</html>