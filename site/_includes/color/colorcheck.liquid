<!DOCTYPE html>
<html dir="ltr" lang="en">
<head>
    {% render '_partials/scripts_styles' %}
    <script src="/scripts/colors/colorcheck.js"></script>
    <link rel="stylesheet" href="/stylesheets/colors/colorcheck.css">
    <title>{{ title }}</title>
</head>
<body style="margin: 0;">
<ilw-page>
    {% render '_partials/header' %}
    <main>
    <div>
    <ilw-content width="page">
        {{ content }}
    </ilw-content>
    <ilw-content width="page">
        <a id="testrun"></a>
        <h2>Test Run Options</h2>
        <div class='flex runoptions'>
            <div>
                <div class='title-buttons'>
                    <h3>Foreground</h3>
                    <button class='ilw-button' id='checkallfore'>Select All</button>
                    <button class='ilw-button' id='checknonefore'>De-select All</button>
                </div>
                <ul id='foreground'>
                <li class="ils-input-entry-compact "><input type='text' id='customcolor-foreground' style="width: 80px;" value="#"><label for='customcolor-foreground'>Custom Color Hex Value</label></li>
                {%- for color in colors.primary %}
                    <li class="ils-input-entry-checkbox"><input type="checkbox" data-name="{{ color.name }}" value="#{{ color.hex }}" id="fore-#{{ color.hex }}"><label for="fore-#{{ color.hex }}">Primary {{ color.description }} {{ color.name }} (#{{ color.hex }})<span class="swatch" role="presentation" style="background-color: #{{ color.hex }};"></span></label></li>
                {%- for tint in color.tints %}
                    <li class="ils-input-entry-checkbox indent"><input type="checkbox" data-name="{{ tint.name }}" value="#{{ tint.hex }}" id="fore-#{{ tint.hex }}"><label for="fore-#{{ tint.hex }}">{{ tint.name }} (#{{ tint.hex }})<span class="swatch" role="presentation" style="background-color: #{{ tint.hex }};"></span></label></li>
                {% endfor -%}
                {% endfor -%}
                {%- for color in colors.secondary %}
                    <li class="ils-input-entry-checkbox"><input type="checkbox" data-name="{{ color.name }}" value="#{{ color.hex }}" id="fore-#{{ color.hex }}"><label for="fore-#{{ color.hex }}">Secondary {{ color.description }} {{ color.name }} (#{{ color.hex }})<span class="swatch" role="presentation" style="background-color: #{{ color.hex }};"></span></label></li>
                {%- for tint in color.tints %}
                    <li class="ils-input-entry-checkbox indent"><input type="checkbox" data-name="{{ tint.name }}" value="#{{ tint.hex }}" id="fore-#{{ tint.hex }}"><label for="fore-#{{ tint.hex }}">{{ tint.name }} (#{{ tint.hex }})<span class="swatch" role="presentation" style="background-color: #{{ tint.hex }};"></span></label></li>
                {% endfor -%}
                {% endfor -%}
                {%- for color in colors.supporting %}
                    <li class="ils-input-entry-checkbox"><input type="checkbox" data-name="{{ color.name }}" value="#{{ color.hex }}" id="fore-#{{ color.hex }}"><label for="fore-#{{ color.hex }}">Supporting {{ color.description }} {{ color.name }} (#{{ color.hex }})<span class="swatch" role="presentation" style="background-color: #{{ color.hex }};"></span></label></li>
                {%- for tint in color.tints %}
                    <li class="ils-input-entry-checkbox indent"><input type="checkbox" data-name="{{ tint.name }}" value="#{{ tint.hex }}" id="fore-#{{ tint.hex }}"><label for="fore-#{{ tint.hex }}">{{ tint.name }} (#{{ tint.hex }})<span class="swatch" role="presentation" style="background-color: #{{ tint.hex }};"></span></label></li>
                {% endfor -%}
                {% endfor -%}
                </ul>
            </div>
            <div>
                <div class='title-buttons'>
                    <h3>Background</h3>
                    <button class='ilw-button' id='checkallback'>Select All</button>
                    <button class='ilw-button' id='checknoneback'>De-select All</button>
                </div>
                <ul id='background'>
                <li class="ils-input-entry-compact"><input type='text' id='customcolor-background' style="width: 80px;" value="#"><label for='customcolor-background'>Custom Color Hex Value</label></li>
                {%- for color in colors.primary %}
                    <li class="ils-input-entry-checkbox"><input type="checkbox" data-name="{{ color.name }}" value="#{{ color.hex }}" id="back-#{{ color.hex }}"><label for="back-#{{ color.hex }}">Primary {{ color.description }} {{ color.name }} (#{{ color.hex }})<span class="swatch" role="presentation" style="background-color: #{{ color.hex }};"></span></label></li>
                {%- for tint in color.tints %}
                    <li class="ils-input-entry-checkbox indent"><input type="checkbox" data-name="{{ tint.name }}" value="#{{ tint.hex }}" id="back-#{{ tint.hex }}"><label for="back-#{{ tint.hex }}">{{ tint.name }} (#{{ tint.hex }})<span class="swatch" role="presentation" style="background-color: #{{ tint.hex }};"></span></label></li>
                {% endfor -%}
                {% endfor -%}
                {%- for color in colors.secondary %}
                    <li class="ils-input-entry-checkbox"><input type="checkbox" data-name="{{ color.name }}" value="#{{ color.hex }}" id="back-#{{ color.hex }}"><label for="back-#{{ color.hex }}">Secondary {{ color.description }} {{ color.name }} (#{{ color.hex }})<span class="swatch" role="presentation" style="background-color: #{{ color.hex }};"></span></label></li>
                {%- for tint in color.tints %}
                    <li class="ils-input-entry-checkbox indent"><input type="checkbox" data-name="{{ tint.name }}" value="#{{ tint.hex }}" id="back-#{{ tint.hex }}"><label for="back-#{{ tint.hex }}">{{ tint.name }} (#{{ tint.hex }})<span class="swatch" role="presentation" style="background-color: #{{ tint.hex }};"></span></label></li>
                {% endfor -%}
                {% endfor -%}
                {%- for color in colors.supporting %}
                    <li class="ils-input-entry-checkbox"><input type="checkbox" data-name="{{ color.name }}" value="#{{ color.hex }}" id="back-#{{ color.hex }}"><label for="back-#{{ color.hex }}">Supporting {{ color.description }} {{ color.name }} (#{{ color.hex }})<span class="swatch" role="presentation" style="background-color: #{{ color.hex }};"></span></label></li>
                {%- for tint in color.tints %}
                    <li class="ils-input-entry-checkbox indent"><input type="checkbox" data-name="{{ tint.name }}" value="#{{ tint.hex }}" id="back-#{{ tint.hex }}"><label for="back-#{{ tint.hex }}">{{ tint.name }} (#{{ tint.hex }})<span class="swatch" role="presentation" style="background-color: #{{ tint.hex }};"></span></label></li>
                {% endfor -%}
                {% endfor -%}
                </ul>
            </div>
        </div>
        <button class='ilw-button ilw-theme-orange-1' id='btnTestColor'>Run Test</button>
        <div>
            <h3>Test Options</h3>
            <p></p>
            <p>
                <label for="displayOptions">Display Options: </label><select id="displayOptions">
                    <option value="all">Show all tests</option>
                    <option value="pass" selected>Show all passing tests</option>
                    <option value="full">Show only passing tests for all sizes</option>
                </select>
            </p>
            <p>
                Sample Text (optional, may include HTML tags, but color checker will ignore them)<br>
                <textarea id='sampletext' style="width: 100%; height: 160px;"></textarea>
            </p>
        </div>
    </ilw-content>
    <ilw-content width="page">
        <h2 id='results-area'>Test Results</h2>
        <p><a href="#testrun">Back to Test Run Options</a></p>
        <div id='colors'></div>
    </ilw-content>
    <ilw-content width="page">
        <h2>Link to current results</h2>
        <p id='link'></p>
    </ilw-content>
    </main>
    {% render '_partials/footer' %}
</body>
</html>


