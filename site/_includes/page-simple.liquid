<!DOCTYPE html>
<html dir="ltr" lang="en">
<head>
    {% render 'scripts_styles' %}
    <title>{{ title }}</title>
    <style>
      code {
          background: #e7e7f7;
          font-size: 1.2rem;
          overflow-wrap: break-word;
      }
      ilw-page-title img {
         -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .5), rgba(0, 0, 0, 0));
      }
    </style>
    {%- if styleurl %}
      <link rel="stylesheet" href="{{ styleurl }}">
    {%- endif %}
    {%- if scripturl %}
      <script type="module" src="{{ scripturl }}"></script>
    {%- endif %}
</head>
<body style="margin: 0;">
  <ilw-page class="ilw-font">
    {% render 'header' %}
    <main style="padding: 0 20px;">
      <ilw-content width="page">
        <h1>{{ title }}</h1>
      </ilw-content>
      {{ content }}
    </main>
    {% render 'footer_no_toolkit' %}
  </ilw-page>
</body>
</html>